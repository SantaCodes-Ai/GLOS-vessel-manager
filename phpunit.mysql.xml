<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/mysql-bootstrap.php"
         cacheDirectory="/tmp/glos-mysql-phpunit-cache"
         colors="true">
    <testsuites>
        <testsuite name="MySQL Integration">
            <directory>tests/Integration/MySql</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="GLOS_MYSQL_TEST_PROFILE" value="isolated-v1" force="true"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="mysql_testing" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="glos_vessel_manager_test" force="true"/>
        <env name="DB_USERNAME" value="glos_test_runner" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_SOCKET" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
