# TEMPLATE ONLY: copy to .env.testing.mysql (runner), chmod 600.
# For preparation, copy separately to .env.testing.mysql.schema and change
# MYSQL_TEST_USERNAME to glos_test_schema. Do not copy the application .env.
APP_ENV=testing
MYSQL_TEST_HOST=127.0.0.1
MYSQL_TEST_PORT=3306
MYSQL_TEST_DATABASE=glos_vessel_manager_test
MYSQL_TEST_USERNAME=glos_test_runner
MYSQL_TEST_PASSWORD=
# Same private, randomly generated 64-character hex token in both profiles.
MYSQL_TEST_OWNERSHIP_TOKEN=
